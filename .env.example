# API base URL – must point to ib-backend (e.g. C:\xampp\htdocs\ib-backend)
# No trailing slash; the app will call /smart-apply, /api/auth, etc. under this base.
VITE_API_URL=https://ib-backend.ib-innovativesolutions.com/api

# Public origin for canonical and Open Graph URLs written by scripts/prerender-seo.mjs
# after `npm run build`. No trailing slash. If unset, the script uses the production site.
# VITE_SITE_URL=https://ib-innovativesolutions.com

# Set to false to skip the SEO HTML shells after `vite build` (npm run build).
# `npm run build:dev` never runs the prerender script.
# VITE_PRERENDER_SEO=true

# Send Me admin (`/sendme/admin`) — password for quotations & invoices UI. Required for production; dev uses `sendme` if unset.
# VITE_SENDME_ADMIN_PASSWORD=

# Send Me booking:
# - Production (`npm run build`): posts to {VITE_API_URL}/sendme/booking (omit VITE_SENDME_API_URL). Deploy that route on ib-backend.
# - Dev: uses VITE_LOCAL_API_URL if set, else http://localhost:5000/api — see vite.config proxy `/api/sendme` → localhost:5000.
# Optional override for any environment (no trailing slash):
# VITE_SENDME_API_URL=https://ib-backend.ib-innovativesolutions.com/api

# When hosting the built app under a subfolder (e.g. http://localhost/app-booker-pro/ on XAMPP),
# set this so JS/CSS load correctly. Include leading slash; trailing slash optional.
# VITE_BASE_PATH=/app-booker-pro/

# Google Maps JavaScript API key (Places Autocomplete on Send Me booking — step 1 address).
# Enable "Maps JavaScript API" and "Places API" in Google Cloud Console; restrict key by HTTP referrer.
# Local dev: add http://localhost:8080/* (this app uses port 8080 — see vite.config). Also 127.0.0.1 if needed.
# If you see RefererNotAllowedMapError, your current page origin is not in the key's referrer list.
# VITE_GOOGLE_MAPS_API_KEY=
